    "def dft(x):\n",
    "    M_points = len(x)\n",
    "    n_arr = np.arange(M_points)\n",
    "    k_arr = np.arange(len(x))\n",
    "    n_k_mat = np.outer(n_arr, k_arr)\n",
    "    W_nk_mat = np.exp(-1j * 2 * np.pi / M_points * n_k_mat)\n",
    "\n",
    "    return W_nk_mat @ x\n",
    "    "
   ]
